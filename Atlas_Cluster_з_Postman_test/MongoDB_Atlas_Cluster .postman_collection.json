  "item": [
    {
      "name": "Users Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));\r",
              "\r",
              "const data = pm.response.json();\r",
              "\r",
              "const id = data?._id || data?.id || (Array.isArray(data) ? (data[0]?._id || data[0]?.id) : null);\r",
              "\r",
              "pm.test(\"POST: response has id\", () => {\r",
              "  pm.expect(id, \"No _id/id in response\").to.be.ok;\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"userId\", id);\r",
              "\r",
              "pm.test(\"POST: userId stored\", () => {\r",
              "  pm.expect(pm.collectionVariables.get(\"userId\")).to.eql(id);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"POST: has name/role/status\", () => {\r",
              "  const obj = Array.isArray(data) ? data[0] : data;\r",
              "  pm.expect(obj).to.have.property(\"name\");\r",
              "  pm.expect(obj).to.have.property(\"role\");\r",
              "  pm.expect(obj).to.have.property(\"status\");\r",
              "});\r",
              "\r",
              "\r",
              "}\r",
              "\r",
              "if (data && data._id) {\r",
              "  pm.collectionVariables.set(\"userId\", data._id);\r",
              "}\r",
              "\r",
              "else if (Array.isArray(data) && data[0]?._id) {\r",
              "  pm.collectionVariables.set(\"userId\", data[0]._id);\r",
              "} else {\r",
              "  throw new Error(\"No _id in POST response\");\r",
              "}\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
