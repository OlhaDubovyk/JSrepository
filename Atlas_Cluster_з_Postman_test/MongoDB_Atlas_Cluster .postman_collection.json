      "name": "Users Get",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"GET all: response is array\", () => {\r",
              "  pm.expect(jsonData).to.be.an(\"array\");\r",
              "  pm.expect(jsonData.length, \"Empty array\").to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "jsonData.forEach((user, i) => {\r",
              "  pm.test(`User[${i}] has _id`, () => pm.expect(user).to.have.property(\"_id\"));\r",
              "  pm.test(`User[${i}] has name`, () => pm.expect(user).to.have.property(\"name\"));\r",
              "  pm.test(`User[${i}] has role`, () => pm.expect(user).to.have.property(\"role\"));\r",
              "});\r",
              "\r",
              "\r",
              "if (!pm.collectionVariables.get(\"userId\") && jsonData[0]?._id) {\r",
              "  pm.collectionVariables.set(\"userId\", jsonData[0]._id);\r",
              "}\r",
              "\r",
              "\r",
              ""
