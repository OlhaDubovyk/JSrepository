    {
      "name": "Negative emait tests",
      "item": [
        {
          "name": "sign up email loop",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('negEmailCases')) {\r",
                  "  const cases = [\r",
                  "    { title: 'cyrillic email', email: 'лоло@бобо.com' },\r",
                  "    { title: 'dot before @', email: '.test@mail.com' },\r",
                  "    { title: 'special symbols', email: 'te!st@mail.com' },\r",
                  "    { title: 'double dot', email: 'te..st@mail.com' },\r",
                  "    { title: 'double @@', email: 'test@@mail.com' },\r",
                  "    { title: 'without domain', email: 'test@' },\r",
                  "    { title: 'missing @', email: 'testmail.com' }\r",
                  "  ];\r",
                  "\r",
                  "  pm.collectionVariables.set('negEmailCases', JSON.stringify(cases));\r",
                  "  pm.collectionVariables.set('negEmailIndex', '0');\r",
                  "}\r",
                  "\r",
                  "const arr = JSON.parse(pm.collectionVariables.get('negEmailCases'));\r",
                  "let i = Number(pm.collectionVariables.get('negEmailIndex'));\r",
                  "const cur = arr[i];\r",
                  "\r",
                  "pm.collectionVariables.set('name', 'John');\r",
                  "pm.collectionVariables.set('lastName', 'Dou');\r",
                  "pm.collectionVariables.set('email', cur.email);\r",
                  "pm.collectionVariables.set('password', 'Qwerty12345');\r",
                  "pm.collectionVariables.set('repeatPassword', 'Qwerty12345');\r",
                  "\r",
                  "const totalTests = 8;"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "pm.test('Status is error', () => {\r",
                  "    pm.expect([400, 422]).to.include(pm.response.code);\r",
                  "});\r",
                  "\r",
                  "pm.test('Error message exists', () => {\r",
                  "    pm.expect(res).to.have.property('message');\r",
                  "    pm.expect(String(res.message).length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "let i = Number(pm.collectionVariables.get('negEmailIndex'));\r",
                  "const casesJson = pm.collectionVariables.get('negEmailCases');\r",
                  "\r",
                  "if (casesJson) {\r",
                  "    const arr = JSON.parse(casesJson);\r",
                  "    i++;\r",
                  "\r",
                  "    if (i < arr.length) {\r",
                  "        pm.collectionVariables.set('negEmailIndex', String(i));\r",
                  "        postman.setNextRequest(pm.info.requestName); // Повтор текущего запроса\r",
                  "    } else {\r",
                  "        \r",
                  "        pm.collectionVariables.unset('negEmailCases');\r",
                  "        pm.collectionVariables.unset('negEmailIndex');\r",
                  "        \r",
                  "    \r",
                  "    \r",
                  "    }\r",
                  "} "
                ],
