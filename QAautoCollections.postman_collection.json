        {
          "name": "sign in",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.variables.get(\"email\");\r",
                  "const pass  = pm.variables.get(\"password\");\r",
                  "\r",
                  "if (!email || !pass) {\r",
                  "  pm.variables.set(\"skipSignIn\", \"1\");\r",
                  "} else {\r",
                  "  pm.variables.unset(\"skipSignIn\");\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.variables.get(\"skipSignIn\") === \"1\") {\r",
                  "  pm.test(\"Skip sign in: no email/password\", function () { this.skip(); });\r",
                  "} else {\r",
                  "  pm.response.to.be.json;\r",
                  "  const res = pm.response.json();\r",
                  "\r",
                  "  pm.test(\"Status code is expected\", function () {\r",
                  "    pm.expect([200, 400, 401, 422]).to.include(pm.response.code);\r",
                  "  });\r",
                  "\r",
                  "  if (pm.response.code === 200) {\r",
                  "    pm.test(\"status is ok\", function () {\r",
                  "      pm.expect(res.status).to.eql(\"ok\");\r",
                  "    });\r",
                  "  } else {\r",
                  "    pm.test(\"status is error\", function () {\r",
                  "      pm.expect(res.status).to.eql(\"error\");\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"error message exists\", function () {\r",
                  "      pm.expect(res.message || res.error).to.be.a(\"string\").and.not.empty;\r",
                  "    });\r",
                  "  }\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
