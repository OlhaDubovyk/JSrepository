        {
          "name": "sign up",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function genPassword() {\r",
                  "  // формат: Qa1 + 8 символов (буквы/цифры)\r",
                  "  const tail = Math.random().toString(36).slice(2, 10);\r",
                  "  return `Qa1${tail}`;\r",
                  "}\r",
                  "\r",
                  "const ts = Date.now();\r",
                  "const email = `test_${ts}@example.com`;\r",
                  "const password = genPassword();\r",
                  "\r",
                  "pm.environment.set('email', email);\r",
                  "pm.environment.set('password', password);\r",
                  "pm.environment.set('repeatPassword', password);\r",
                  "\r",
                  "pm.environment.set('currentPassword', password);\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);\r",
                  "\r",
                  "let res = {};\r",
                  "try { res = pm.response.json(); } catch (e) {}\r",
                  "\r",
                  "pm.test(\"Signup status code ok/negative\", () => {\r",
                  "  pm.expect([201, 400, 409, 422]).to.include(pm.response.code);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201 && res?.status === \"ok\") {\r",
                  "  pm.environment.set(\"userId\", res.data?.userId || res.data?.id || \"\");\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
